# ScootyBook Production Environment Configuration
# Copy this file to .env on your VPS and update with real values

# ============================================
# REQUIRED CONFIGURATION
# ============================================

# Application Environment
NODE_ENV=production
PORT=5001

# Database Configuration
# IMPORTANT: Update with your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/scootybook

# Security Secrets
# IMPORTANT: Generate strong random secrets (32+ characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS

# Application URLs
CLIENT_URL=https://scootybook.kusalpabasara.me
REACT_APP_API_URL=https://scootybook.kusalpabasara.me/api

# Google Maps API
REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyBcXN9OTtI5plUcbX5Y4QucMrK3-0ftaSk

# ============================================
# OPTIONAL SERVICES (Not Required for Core Functionality)
# ============================================

# Email Service (Optional - for booking notifications)
# Leave commented out if not using email notifications
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_FROM=ScootyBook <your_email@gmail.com>
# APP_URL=https://scootybook.kusalpabasara.me

# SMS Service (Optional - for SMS notifications via Twilio)
# Leave commented out if not using SMS
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number
# SMS_ENABLED=false
# SMS_SEND_CONFIRMATION=false
# SMS_SEND_STATUS_UPDATES=false
# SMS_SEND_REMINDERS=false

# OAuth Login (Optional - for Google/Facebook login)
# Leave commented out if only using email/password login
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret

# ============================================
# DEPLOYMENT INSTRUCTIONS
# ============================================
#
# 1. Copy this file to /apps/scootybook/.env on your VPS
# 2. Generate JWT_SECRET and SESSION_SECRET:
#    openssl rand -base64 32
# 3. Update MONGODB_URI with your actual MongoDB connection string
# 4. Save the file
# 5. Restart the application:
#    pm2 restart scootybook
#
